# Copy to .env and fill in values. Lose the Cosmos/SignalR/App Insights vars.

# --- AIKA GPS ---
AIKA_SERVER_URL=http://www.aika168.com/
AIKA_DEVICE_ID=
AIKA_PASSWORD=

# --- Poller ---
POLL_INTERVAL_SECONDS=60

# --- Device command PIN ---
COMMAND_PIN=1236

# --- Feature flags (same names as before) ---
ENABLE_SECURITY_ALERT=true
SAVE_RAW_PAYLOAD=true
BROADCAST_ALL_POLLS=false
ENABLE_CLOUD_MESSAGING=false
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
AUTOMATE_ENABLED=false
AUTOMATE_SECRET=
AUTOMATE_TO=
AUTOMATE_DEVICE=

# --- Location search ---
GOOGLE_MAPS_API_KEY=

# --- CORS (comma-separated; add your Static Web Apps origin + local dev ports) ---
# e.g. http://localhost:5173 (vite dev), http://localhost:4173 (vite preview), your prod frontend
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://icy-forest-0a1dece00.net

# --- Postgres ---
POSTGRES_PASSWORD=

# --- Postgres (docker-compose overrides DATABASE_URL for the container) ---
# DATABASE_URL=postgresql+asyncpg://tracker:<POSTGRES_PASSWORD>@localhost:5432/biketracker
